# /etc/rukhnav/rukhnav.env
# DO NOT COMMIT THIS REAL FILE.

NODE_ENV=production
APP_ENV=production
CUSTOMER_VERIFICATION_MODE=production

PORT=3000

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=rukhnav
DB_CONNECTION_LIMIT=10

# Set true only if your managed MySQL provider requires TLS.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=
JWT_EXPIRES_IN=7d

# First launch can use one domain.
# Example:
# CORS_ORIGINS=https://rukhnav.com,https://www.rukhnav.com
CORS_ORIGINS=

UPLOAD_ROOT=/data/rukhnav/uploads

APP_TIMEZONE=Asia/Karachi
EVENT_REMINDER_TIMEZONE=Asia/Karachi

SIMULATION_MODE=true
EMAIL_DELIVERY_ENABLED=false
WHATSAPP_DELIVERY_ENABLED=false
SMS_DELIVERY_ENABLED=false

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=

SMS_PROVIDER=
SMS_API_KEY=
