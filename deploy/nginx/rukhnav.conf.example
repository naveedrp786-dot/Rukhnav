# RUKHNAV Nginx reverse-proxy template
# Use only on a VPS/server where you manage Nginx yourself.
# Managed cloud platforms usually provide HTTPS and proxying automatically.

server {
    listen 80;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    # After DNS is working, use your platform/Certbot to redirect HTTP to HTTPS.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 120s;
        proxy_send_timeout 120s;

        client_max_body_size 25M;
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:3000/api/health;
        proxy_set_header Host $host;
        access_log off;
    }
}
