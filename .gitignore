# ==============================
# RUKHNAV - Git Ignore
# ==============================

# Secrets / environment files
.env
.env.*
backend/.env
backend/.env.*
!backend/.env.production.example

# Dependencies
node_modules/
**/node_modules/

# Database / local backups
backend/backups/
backups/
*.sql
*.dump

# Runtime uploads
backend/uploads/
uploads/

# Logs
*.log
npm-debug.log*
logs/

# macOS
.DS_Store
**/.DS_Store

# Editors
.vscode/
.idea/

# Archives
*.zip
*.tar
*.tar.gz

# Temporary / backup source files
*.before-*
*.backup.js
*.PATCH.js

# Coverage
coverage/

# Additional private/local files
backend/environment-files/
backend/resetAdminPassword.js
.postman/
postman/

# Redundant root Node package files
/package.json
/package-lock.json

# RUKHNAV local safety snapshots
*.backup-before-*
*.backup-*
*.stage2-backup
